{{ 'component-purelane.css' | asset_url | stylesheet_tag }}
{% render 'purelane-theme-colors' %}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tier_blocks = section.blocks | where: 'type', 'tier'
-%}

<section class="purelane-section" id="bundles" data-section-id="{{ section.id }}">
  <div class="purelane-wrap">
    <div class="purelane-glass" style="padding: clamp(26px, 3.4vw, 40px); margin-bottom: 16px;">
      <div class="purelane-panel-head" style="margin-bottom: 0;">
        {%- if section.settings.kicker != blank -%}
          <span class="purelane-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="purelane-heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.lede != blank -%}
          <div class="purelane-lede">{{ section.settings.lede }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- if tier_blocks.size > 0 -%}
      <div class="purelane-tiers">
        {%- for block in tier_blocks -%}
          {%- liquid
            assign tier = block.settings.product
          -%}
          {%- if tier != blank -%}
            {%- liquid
              assign perks = tier.metafields.custom.bundle_perks.value
              assign product_count = tier.metafields.custom.bundle_product_count.value
              assign is_featured = false
              if tier.metafields.custom.featured.value
                assign is_featured = true
              endif
              if product_count > 0
                assign per_unit_cents = tier.price | times: 1.0 | divided_by: product_count | round
                assign per_unit_price = per_unit_cents | money
              endif
            -%}
            <article
              class="purelane-tier purelane-glass purelane-card-hover{% if is_featured %} purelane-tier--featured{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.tag_label != blank -%}
                <span class="purelane-tier__tag">{{ block.settings.tag_label }}</span>
              {%- endif -%}
              <h3 class="purelane-visually-hidden">{{ tier.title | escape }}</h3>
              <div class="purelane-tier__pix" aria-hidden="true">
                {% render 'purelane-media', image: tier.featured_image, alt: tier.title, class: 'purelane-tier__pix-image', sizes: '80px' %}
              </div>
              {%- if product_count > 0 -%}
                <div class="purelane-tier__qty">
                  {{ product_count }}<small>{{ 'purelane.bundles.products_label' | t }}</small>
                </div>
              {%- endif -%}
              <div class="purelane-tier__price">
                {{ tier.price | money }}
                {%- if tier.compare_at_price > tier.price -%}
                  <s class="purelane-price-compare">{{ tier.compare_at_price | money }}</s>
                {%- endif -%}
              </div>
              {%- if per_unit_price -%}
                <p class="purelane-tier__per-unit">{{ 'purelane.bundles.per_product' | t: amount: per_unit_price }}</p>
              {%- endif -%}
              {%- if perks.size > 0 -%}
                <ul class="purelane-tier__perks">
                  {%- for perk in perks -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 13 4 4L19 7"/></svg>
                      {{ perk | escape }}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <a class="purelane-btn {% if is_featured %}purelane-btn--primary{% else %}purelane-btn--ghost{% endif %} purelane-btn--full" href="{{ tier.url }}">
                {{ section.settings.cta_text }}
                <span class="purelane-visually-hidden">{{ tier.title | escape }}</span>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="purelane-shop__empty">{{ 'purelane.bundles.no_tiers' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane bundles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "richtext", "id": "lede", "label": "Supporting text", "default": "<p>Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Build this box" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product",
          "info": "A real product priced for this tier. Add custom.bundle_product_count / custom.bundle_perks / custom.featured metafields — see docs/METAFIELDS.md."
        },
        { "type": "text", "id": "tag_label", "label": "Tag", "default": "Starter" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag_label": "Starter" } },
        { "type": "tier", "settings": { "tag_label": "Most popular" } },
        { "type": "tier", "settings": { "tag_label": "Whole home" } }
      ]
    }
  ]
}
{% endschema %}
